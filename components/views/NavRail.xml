<?xml version="1.0" encoding="utf-8"?>
<component name="NavRail" extends="Group">
    <interface>
        <field id="active" type="string" value="home" onChange="paint" />
        <field id="profileName" type="string" onChange="paint" />
        <field id="profileColor" type="string" onChange="paint" />
        <field id="profileAvatar" type="string" onChange="paint" />
        <field id="accent" type="string" value="0x7C4DFFFF" onChange="paint" />
        <field id="chosen" type="string" alwaysNotify="true" />
        <field id="leave" type="boolean" alwaysNotify="true" />
        <field id="discover" type="boolean" value="false" onChange="onDiscover" />
        <field id="modern" type="boolean" value="false" onChange="paint" />
        <field id="blur" type="boolean" value="false" onChange="paint" />
        <field id="collapsed" type="boolean" value="false" onChange="paint" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Mask.brs" />
    <script type="text/brightscript" uri="pkg:/components/Config.brs" />
    <script type="text/brightscript" uri="pkg:/components/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/views/NavRail.brs" />
    <children>
        <Poster id="panel" visible="false" width="700" height="1080" uri="pkg:/images/rail_bg.png" loadDisplayMode="scaleToFill" />
        <Poster id="float" visible="false" translation="[20,28]" width="470" height="1024" uri="pkg:/images/panel.9.png" />
        <Group id="pill" visible="false" translation="[40,40]">
            <Poster id="pillBg" height="64" uri="pkg:/images/pill.9.png" />
            <Poster id="pillIcon" translation="[16,16]" width="32" height="32" />
            <Label id="pillText" translation="[62,0]" height="64" vertAlign="center" font="font:SmallBoldSystemFont" color="0xF2F2F7FF" />
        </Group>
        <Timer id="pillTimer" duration="3" repeat="false" />
        <Group id="entries" />
    </children>
</component>
