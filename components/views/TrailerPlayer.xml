<?xml version="1.0" encoding="utf-8"?>
<component name="TrailerPlayer" extends="Group">
    <interface>
        <field id="trailer" type="assocarray" onChange="onTrailer" />
        <field id="event" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Config.brs" />
    <script type="text/brightscript" uri="pkg:/components/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/Util.brs" />
    <script type="text/brightscript" uri="pkg:/components/views/TrailerPlayer.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="true" />
        <Label id="loading" translation="[0,500]" width="1920" horizAlign="center" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" text="Cargando tráiler..." />
    </children>
</component>
