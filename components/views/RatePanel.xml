<?xml version="1.0" encoding="utf-8"?>
<component name="RatePanel" extends="Group">
    <interface>
        <field id="data" type="assocarray" onChange="onData" />
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Config.brs" />
    <script type="text/brightscript" uri="pkg:/components/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/Util.brs" />
    <script type="text/brightscript" uri="pkg:/components/views/RatePanel.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000B8" />
        <Group id="card" translation="[540,190]">
